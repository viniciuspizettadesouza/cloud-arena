{
  "name": "cloud-arena",
  "version": "0.0.0",
  "private": true,
  "description": "Deterministic AWS, Azure, and GCP architecture and public-price comparison engine.",
  "license": "UNLICENSED",
  "packageManager": "pnpm@11.23.0",
  "engines": {
    "node": ">=24.18.0 <25",
    "pnpm": "11.23.0"
  },
  "scripts": {
    "boundaries": "node scripts/check-boundaries.mjs",
    "build": "turbo run build",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "db:check": "pnpm --filter @cloud-arena/database db:check",
    "db:down": "node scripts/compose.mjs down",
    "db:generate": "pnpm --filter @cloud-arena/database db:generate",
    "db:migrate": "pnpm --filter @cloud-arena/database db:migrate",
    "db:up": "node scripts/compose.mjs up -d --wait",
    "dev": "turbo run dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings 0 && pnpm boundaries",
    "test": "turbo run test",
    "test:e2e": "playwright test",
    "typecheck": "turbo run typecheck"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.62.1",
    "@types/node": "26.3.0",
    "eslint": "10.9.1",
    "globals": "17.11.0",
    "prettier": "3.9.6",
    "turbo": "2.10.11",
    "typescript": "6.0.3",
    "typescript-eslint": "8.68.0",
    "vitest": "4.1.11"
  }
}
